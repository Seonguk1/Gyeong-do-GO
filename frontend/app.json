{
  "expo": {
    "name": "Gyeong-do-GO",
    "slug": "Gyeong-do-GO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gyeongdogo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.kimmiki.gyeongdo",
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyDsyWLpiyTgL5ha4svzGvn24oFDBU1ZiAo"
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "서버와 통신하기 위해 로컬 네트워크 권한이 필요합니다."
      }
    },
    "android": {
      "package": "com.kimmiki.gyeongdo",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDsyWLpiyTgL5ha4svzGvn24oFDBU1ZiAo"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
