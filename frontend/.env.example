# Backend API Configuration
# Set the production server and localhost hostnames/IPs
EXPO_PUBLIC_SERVER_IP=server_ip
EXPO_PUBLIC_LOCALHOST_IP=localhost

# Toggle between localhost and server. Set to 'true' to use localhost.
EXPO_PUBLIC_USE_LOCALHOST=true

# API port (default 8080)
EXPO_PUBLIC_API_PORT=8080

# Optional explicit override (uncomment to force a full URL)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8080
# EXPO_PUBLIC_WS_URL=ws://192.168.1.100:8080/ws

# Google Maps API Key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Environment
EXPO_PUBLIC_ENV=development
